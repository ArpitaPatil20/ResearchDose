# ResearchDose Environment Configuration Example
APP_NAME="ResearchDose — Scientific Dose Conversion & Research Platform"
APP_ENV="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# SQLite Local Database
DATABASE_URL="sqlite:///./researchdose.db"

# Numerical Precision & Engine Defaults
DEFAULT_DECIMAL_PLACES=4
CALCULATION_ENGINE_VERSION="1.0.0"
DATASET_VERSION="2025.1"
